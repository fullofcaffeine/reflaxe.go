{
  "name": "reflaxe.go",
  "private": true,
  "version": "0.0.0",
  "packageManager": "npm@11.16.0",
  "license": "GPL-3.0-only",
  "description": "Reflaxe-based Go target for Haxe",
  "scripts": {
    "postinstall": "lix download",
    "dev:new-project": "bash scripts/dev/new-project.sh",
    "dev:hx": "bash scripts/dev/go-hx.sh",
    "dev:goextern": "bash scripts/dev/goextern.sh",
    "compatibility:generate": "python3 scripts/compatibility/generate_support_manifest.py",
    "compatibility:verify": "python3 scripts/compatibility/generate_support_manifest.py --check",
    "test": "npm run test:canonical-std-layout && npm run test:haxelib-package && npm run test:output-confinement && npm run test:canonical-std-closeout && npm run test:compiler-debt && python3 test/run-snapshots.py && npm run test:sys-get-char-terminal",
    "test:ci": "python3 test/run-ci.py",
    "test:examples": "python3 test/run-examples.py",
    "test:examples:changed": "python3 test/run-examples.py --changed",
    "test:list": "python3 test/run-snapshots.py --list",
    "test:negative": "python3 test/run-snapshots.py --category negative",
    "test:go-native": "python3 test/run-snapshots.py --category go_native",
    "test:failed": "python3 test/run-snapshots.py --failed",
    "test:changed": "npm run test:canonical-std-layout && npm run test:haxelib-package && npm run test:output-confinement && npm run test:canonical-std-closeout && npm run test:compiler-debt && python3 test/run-snapshots.py --changed && npm run test:sys-get-char-terminal",
    "test:canonical-std-layout": "python3 test/test_canonical_std_layout_contract.py",
    "test:haxelib-package": "python3 test/test_haxelib_package_runner.py",
    "test:output-confinement": "python3 test/test_generated_output_confinement.py",
    "test:sys-get-char-terminal": "python3 test/test_sys_get_char_terminal.py",
    "test:compiler-debt": "python3 test/run-compiler-debt-ratchet.py",
    "test:optimizer:matrix": "python3 test/run-snapshots.py --case core/optimizer_plan_string_fastpath_enabled --case core/optimizer_plan_string_fastpath_disabled --case core/optimizer_plan_opt_none_concurrency_default_off --case core/optimizer_plan_opt_none_concurrency_override_on --case core/optimizer_plan_portable_fast_concurrency_override_off --case core/optimizer_plan_portable_fast_concurrency_default_on",
    "test:update": "python3 test/run-snapshots.py --update",
    "test:bless": "python3 test/run-snapshots.py --bless",
    "test:semantic-diff": "python3 test/run-semantic-diff.py",
    "test:semantic-diff:optimizer-matrix": "python3 test/run-semantic-diff.py --case go_string_fastpath_on_off_contract_on --case go_string_fastpath_on_off_contract_off --case go_chan_fastpath_on_off_contract_on --case go_chan_fastpath_on_off_contract_off --case go_chan_fastpath_opt_none_default_off_contract --case go_chan_fastpath_opt_none_override_on_contract",
    "test:semantic-diff:lanes": "python3 test/run-semantic-diff.py --suite lanes",
    "test:auto-planner:schema": "python3 test/run-auto-planner-schema.py",
    "test:release-contracts": "python3 test/run-release-contracts.py",
    "test:canonical-std-closeout": "python3 test/test_canonical_std_closeout_contract.py",
    "test:haxelib-artifact": "python3 test/test_haxelib_release_artifact.py",
    "test:haxelib-release-install": "python3 test/test_haxelib_release_install.py",
    "test:release-version-policy": "node test/test_release_version_policy.mjs",
    "test:examples:metal-boundary": "python3 test/run-metal-example-boundary.py",
    "test:goextern:fixtures": "python3 test/run-goextern-fixtures.py",
    "test:stdlib-sweep": "python3 test/run-upstream-stdlib-sweep.py",
    "test:stdlib-sweep:strict": "python3 test/run-upstream-stdlib-sweep.py --strict",
    "test:stdlib-sweep:go-test": "python3 test/run-upstream-stdlib-sweep.py --strict --go-test",
    "test:stdlib-sweep:full": "python3 test/run-upstream-stdlib-sweep.py --modules-file test/upstream_std_modules_full.txt --strict",
    "test:stdlib-sweep:full:go-test": "python3 test/run-upstream-stdlib-sweep.py --modules-file test/upstream_std_modules_full.txt --strict --go-test",
    "test:stdlib-inventory": "python3 test/run-portable-stdlib-inventory.py",
    "test:portable-allowlist": "python3 test/run-portable-allowlist.py",
    "test:portable-conformance": "python3 test/run-portable-conformance.py",
    "test:portable-parity-closure": "python3 test/run-portable-parity-closure.py",
    "test:family-stdlib-bootstrap": "python3 family/reflaxe.family.std/tools/verify_family_std.py",
    "test:family-stdlib-sync": "python3 tools/family_std_sync.py --mode verify",
    "family:stdlib:export": "python3 tools/family_std_sync.py --mode export",
    "family:stdlib:import": "python3 tools/family_std_sync.py --mode import",
    "test:stdlib:boundary": "node scripts/ci/upstream-stdlib-boundary-check.js",
    "test:stdlib:provenance": "node scripts/ci/stdlib-provenance-ledger-check.js",
    "test:stdlib:migration-ledger": "python3 test/test_stdlib_migration_ledger_contract.py",
    "test:stdlib:governance": "npm run test:stdlib:boundary && npm run test:stdlib:provenance && npm run test:stdlib:migration-ledger",
    "test:pure-go:pulseforge": "cd benchmarks/pure_go/pulseforge && go test ./...",
    "test:pure-go:fluxproxy": "cd benchmarks/pure_go/fluxproxy && go test ./...",
    "test:perf:pure-go:pulseforge": "cd benchmarks/pure_go/pulseforge && go test -run '^$' -bench . -benchmem",
    "test:perf:pure-go:fluxproxy": "cd benchmarks/pure_go/fluxproxy && go test -run '^$' -bench . -benchmem",
    "test:perf:apps": "bash scripts/ci/perf-apps.sh",
    "test:perf:apps:update-baseline": "bash scripts/ci/perf-apps.sh --update-baseline",
    "test:perf:go": "bash scripts/ci/perf-go-profiles.sh",
    "test:perf:stdlib-shims": "bash scripts/ci/perf-stdlib-shim-review.sh",
    "test:perf:go:update-baseline": "bash scripts/ci/perf-go-profiles.sh --update-baseline",
    "test:perf:hxrt-selective": "bash scripts/ci/perf-hxrt-selective.sh",
    "test:perf:hxrt-selective:update-baseline": "bash scripts/ci/perf-hxrt-selective.sh --update-baseline",
    "test:goextern": "cd tools/goextern && go test ./...",
    "examples:compile": "python3 test/run-examples.py --compile-only",
    "examples:bless": "python3 test/run-examples.py --bless-generated",
    "examples:sync": "python3 scripts/examples/sync-generated.py",
    "examples:bins": "bash scripts/examples/build-binaries.sh",
    "hooks:install": "bash scripts/install-git-hooks.sh",
    "security:gitleaks": "bash scripts/security/run-gitleaks.sh",
    "security:deps": "bash scripts/security/run-dependency-audit.sh",
    "security:go-tooling": "python3 scripts/security/run-go-tooling-gates.py",
    "security:supply-chain": "python3 scripts/security/verify-supply-chain.py",
    "verify:vendor-reflaxe": "python3 scripts/vendor/verify-reflaxe-provenance.py",
    "verify:vendor-reflaxe:reconstruct": "python3 scripts/vendor/verify-reflaxe-provenance.py --reconstruct",
    "release:status": "bash scripts/release/check-release-state.sh",
    "release:license-policy": "python3 scripts/release/verify-license-policy.py --mode release",
    "release:policy": "python3 scripts/release/verify-release-policy.py",
    "release:stage-metadata": "python3 scripts/release/stage-release-metadata.py",
    "release:build-haxelib": "python3 scripts/release/build-haxelib-artifact.py",
    "release:verify-haxelib": "python3 scripts/release/verify-haxelib-artifact.py",
    "package:haxelib": "bash scripts/release/package-haxelib.sh",
    "release": "bash scripts/release/run-same-sha-release.sh",
    "release:dry-run": "bash scripts/release/run-same-sha-release.sh --dry-run"
  },
  "devDependencies": {
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "conventional-changelog-conventionalcommits": "^8.0.0",
    "lix": "^15.0.0",
    "semantic-release": "^25.0.7",
    "semver": "^7.8.5"
  }
}
