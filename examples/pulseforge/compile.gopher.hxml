-cp .
-cp ../../src
-cp ../../vendor/reflaxe/src
--macro reflaxe.go.CompilerBootstrap.Start()
--macro reflaxe.go.CompilerInit.Start()
-D go_output=out_gopher
-D go_module=examples_pulseforge_gopher
-D reflaxe_go_profile=gopher
-D reflaxe_go_strict_examples
-D pulseforge_profile_gopher
-D pulseforge_variant_core
-main Main
