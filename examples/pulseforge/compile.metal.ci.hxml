-cp .
-cp ../../src
-cp ../../vendor/reflaxe/src
--macro reflaxe.go.CompilerBootstrap.Start()
--macro reflaxe.go.CompilerInit.Start()
-D go_output=out_metal_ci
-D go_module=examples_pulseforge_metal_ci
-D reflaxe_go_profile=metal
-D reflaxe_go_strict_examples
-D reflaxe_go_auto_empty_ctor_interfaces=app.runtime.PulseRuntime
-D pulseforge_profile_metal
-D pulseforge_variant_go_native
-D example_ci
-main Main
