-cp .
-cp ../../src
-cp ../../vendor/reflaxe/src
--macro reflaxe.go.CompilerBootstrap.Start()
--macro reflaxe.go.CompilerInit.Start()
-D go_output=out_metal
-D go_module=examples_fluxproxy_metal
-D reflaxe_go_profile=metal
-D reflaxe_go_strict_examples
-D reflaxe_go_auto_empty_ctor_interfaces=app.runtime.FluxRuntime
-D fluxproxy_profile_metal
-D fluxproxy_variant_core
-main Main
