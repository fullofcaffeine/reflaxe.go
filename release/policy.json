{
  "schemaVersion": 1,
  "normalChannel": {
    "branch": "master",
    "tagFormat": "v${version}",
    "prerelease": false,
    "productMaturityAuthority": "docs/compatibility-support-manifest.json"
  },
  "deprecationPolicy": {
    "majorZero": {
      "noticeRelease": "minor",
      "minimumFunctionalMinorReleasesAfterNotice": 1,
      "earliestRemovalMinorOffset": 2
    },
    "stable": {
      "noticeRelease": "minor",
      "removalRelease": "next-major"
    },
    "emergencyExceptionRequires": [
      "review-record",
      "release-note",
      "migration-guidance"
    ]
  },
  "experimentalPolicy": {
    "compatibilityPromise": "excluded-unless-admitted",
    "minimumChangeRelease": "minor",
    "stableMinorException": "requires-explicit-surface-proof"
  },
  "releaseLines": {
    "0": {
      "stage": "initial-development",
