{
	"schemaVersion": 1,
	"contract": "portable",
	"optimizationPreset": "portable_fast",
	"portableStringFastpathEnabled": true,
	"portableConcurrencyFastpathEnabled": true,
	"stringInstanceTypedLowerings": 4,
	"stringInstanceLegacyLowerings": 0,
	"stringLengthFieldTypedLowerings": 2,
	"stringLengthFieldLegacyLowerings": 0,
	"portableConcurrencyTypedFastpathHits": 3,
	"portableConcurrencyTypedFastpathFallbacks": 0,
	"goAstPasses": [
		"normalize_names",
		"rewrite_string_ops",
		"rewrite_virtual_calls",
		"insert_runtime_prelude",
		"elide_blank_identifier_guards",
		"collect_imports"
	]
}
