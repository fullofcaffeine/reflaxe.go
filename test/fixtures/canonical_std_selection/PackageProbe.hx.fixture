/**
 * What: identifies the packaged cross-target override selected by the test.
 * Why: an archive can have the right filenames while Haxe still types the upstream module.
 * How: the contract stages this fixture as Lambda.cross.hx and asserts runtime output.
 */
class Lambda {
  public static function has<T>(values:Iterable<T>, expected:T):Bool {
    for (value in values) {
      if (value == expected) {
        return true;
      }
    }
    return false;
  }

  public static function iter<T>(values:Iterable<T>, visit:T->Void):Void {
    for (value in values) {
      visit(value);
    }
  }

  public static function find<T>(values:Iterable<T>, predicate:T->Bool):Null<T> {
    for (value in values) {
      if (predicate(value)) {
        return value;
      }
    }
    return null;
  }

  public static function origin():String {
    return "package-override";
  }
}
