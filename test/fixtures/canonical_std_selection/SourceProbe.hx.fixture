/**
 * What: identifies the ordinary-Haxe source override selected by the test.
 * Why: file-presence checks cannot prove that target overrides beat an upstream shadow.
 * How: the contract compiles this fixture as Lambda.hx and asserts runtime output.
 */
class Lambda {
  public static function has<T>(values:Iterable<T>, expected:T):Bool {
    for (value in values) {
      if (value == expected) {
        return true;
      }
    }
    return false;
  }

  public static function iter<T>(values:Iterable<T>, visit:T->Void):Void {
    for (value in values) {
      visit(value);
    }
  }

  public static function find<T>(values:Iterable<T>, predicate:T->Bool):Null<T> {
    for (value in values) {
      if (predicate(value)) {
        return value;
      }
    }
    return null;
  }

  public static function origin():String {
    return "source-override";
  }
}
