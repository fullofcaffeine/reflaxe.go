/**
 * What: supplies the same Lambda module name as the target-specific fixtures.
 * Why: selection must be proven against a real competing upstream module.
 * How: returning a distinct marker makes an incorrect selection visible at runtime.
 */
class Lambda {
  public static function has<T>(values:Iterable<T>, expected:T):Bool {
    for (value in values) {
      if (value == expected) {
        return true;
      }
    }
    return false;
  }

  public static function iter<T>(values:Iterable<T>, visit:T->Void):Void {
    for (value in values) {
      visit(value);
    }
  }

  public static function find<T>(values:Iterable<T>, predicate:T->Bool):Null<T> {
    for (value in values) {
      if (predicate(value)) {
        return value;
      }
    }
    return null;
  }

  public static function origin():String {
    return "upstream-shadow";
  }
}
