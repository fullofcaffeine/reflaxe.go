-cp .
-lib reflaxe.go
-D go_output=out-metal
-D reflaxe_go_profile=metal
-D reflaxe_go_native_specialization=proven
-D reflaxe_go_surface_contract_report
-D reflaxe_go_type_usage_report
-D reflaxe_go_optimizer_plan_report
-D reflaxe_go_runtime_plan_report
-D reflaxe_go_hxrt_features=core
-D reflaxe_go_portable_native_policy=off
-D reflaxe.dont_output_metadata_id
-D no-traces
-D no_traces
-dce full
-main Main
