{
  "branches": [
    "master"
  ],
  "tagFormat": "v${version}",
  "plugins": [
    [
      "./scripts/release/analyze-commits.mjs",
      {
        "approvedStableMajors": []
      }
    ],
    [
      "@semantic-release/github",
      {
        "successCommentCondition": false,
        "failCommentCondition": false,
        "releasedLabels": false,
        "addReleases": false
      }
    ]
  ]
}
